// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  provider          Provider
  username          String    @unique
  name              String?
  password          String?
  passwordUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(CANDIDATE)
  phone     String?
  avatar    String?
  avatar_id String?

  profileStatus    ProfileStatus @default(active)
  Session          Session? // remove accessToken/refreshToken from User; they belong to Session
  permanentAddress Address?      @relation("PermanentAddress")
  profile          Profile?
  
  @@index([role])
  @@index([profileStatus])
  @@index([emailVerified])
}

// ===================================
// Session Management
// ===================================

model Session {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: userId, references: id, onDelete: Cascade)
  refreshToken             String
  refreshTokenDateOfExpire BigInt
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  active                   Boolean  @default(true)
  userAgent                String?
  deviceId                 String   @unique

  @@index([userId])
}

// ===================================
// Profile
// ===================================

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: userId, references: id, onDelete: Cascade)

  resume    String?
  designation String?
  resume_id String?
  bio       String?
  headline  String?
  mode      Mode     @default(light)
  layout    Layout   @default(default)  

  linkedin String?
  github   String?
  twitter  String?
  website  String?

  contacts       Contact[]
  currentAddress Address?  @relation("CurrentAddress")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  educations  Education[]
  experiences Experience[]
  skills      Skill[]
  projects    Projects[]
}

model Projects {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: profileId, references: id, onDelete: Cascade)

  name        String
  description String?
  liveLink        String?
  githubLink  String?
  technologies String?
  startDate   DateTime?
  endDate     DateTime?
  projectType ProjectType
  myContribution String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ===================================
// Address
// ===================================

model Address {
  id              String  @id @default(cuid())
  permanentUserId String? @unique
  permanentUser   User?   @relation("PermanentAddress", fields: [permanentUserId], references: [id], onDelete: Cascade)

  // Current Address Relation
  currentProfileId String?  @unique
  currentProfile   Profile? @relation("CurrentAddress", fields: [currentProfileId], references: [id], onDelete: Cascade)

  city     String?
  district String?
  state    String?
  country  String?
  pinCode  String?
}

// ===================================
// Contact (Normalized)
// ===================================

model Contact {
  id String @id @default(cuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type  ContactType
  value String

  createdAt DateTime @default(now())

  @@index([profileId])
}

// ===================================
// Education
// ===================================

model Education {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: profileId, references: id, onDelete: Cascade)

  institution  String?
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  grade        String?
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ===================================
// Experience
// ===================================

model Experience {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: profileId, references: id, onDelete: Cascade)

  company          String
  position         String
  employmentType   EmploymentType
  location         String?
  startDate        DateTime?
  endDate          DateTime?
  currentlyWorking Boolean        @default(false)
  description      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ===================================
// Skill
// ===================================

model Skill {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: profileId, references: id, onDelete: Cascade)

  name  String
  level SkillLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, name])
  @@index([profileId])
}

// ===================================
// Enums
// ===================================


enum Provider {
  GOOGLE
  MANUAL
}

enum ProfileStatus {
  active
  suspended
  deactivated
}

enum Role {
  RECRUITER
  CANDIDATE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ContactType {
  EMAIL
  PHONE
  WHATSAPP
  TELEGRAM
  LINKEDIN
  OTHER
}

enum Mode {
  light
  dark
}

enum Layout {
  default
}

enum ProjectType {
  PERSONAL
  ACADEMIC
  PROFESSIONAL
}